{
  "permissions": {
    "allow": [
      "Bash(timeout 10:*)",
      "Bash(npm run dev:*)",
      "Bash(ping:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(taskkill:*)",
      "Bash(powershell -Command \"Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_OwningProcess -Force -ErrorAction SilentlyContinue }\")",
      "Bash(cmd /c \"taskkill /F /IM node.exe\")",
      "Bash(cmd /c \"taskkill /F /PID 14420\")",
      "Bash(cmd /c \"taskkill /F /PID 14420 2>&1\")"
    ]
  }
}
